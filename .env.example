# Copy to .env and adjust. Every value here is optional; the defaults let the
# console start with CSV workflows and web basemaps only.

# ── Model ────────────────────────────────────────────────────────────────
# Ultralytics-compatible checkpoint. Leave empty to pick one in the UI.
MODEL_PATH=/models/YOLO12n_plantweed1280-best.pt

# Which checkpoint labels count as crop. Anything unlisted is treated as a
# weed, because over-counting weeds is the safer error for a stand decision.
PLANT_CLASSES=plant,crop,soybean,faba,fababean
WEED_CLASSES=weed,palmer,ragweed,grass

# ── Data ─────────────────────────────────────────────────────────────────
DATA_DIR=/data/plantai
# Directories the UI's file browser may list (rasters and .pt checkpoints).
LIBRARY_DIRS=/models,/data
# Set to 0 to force every raster through the upload endpoint.
ALLOW_LOCAL_PATHS=1
MAX_UPLOAD_MB=8192

# ── Inference defaults ───────────────────────────────────────────────────
TILE_SIZE=1280
BATCH_TILES=4
YOLO_CONF=0.25
YOLO_IOU=0.45
DEDUP_RADIUS_M=0.10
SIDE_OVERLAP=0.30
FRONT_OVERLAP=0.30

# ── Agronomy defaults ────────────────────────────────────────────────────
STAND_TARGET=150000
STAND_ALERT_PCT=85

# ── HTTP ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SERVE_FRONTEND=1
